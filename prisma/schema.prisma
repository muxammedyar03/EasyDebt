generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CLIENT (tenant / shop / magazin)
// ============================================================================

model Client {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users                   User[]
  debtors                 Debtor[]
  debts                   Debt[]
  payments                Payment[]
  settings                Settings[]
  audit_logs              AuditLog[]
  notifications           Notification[]
  payment_reminders       PaymentReminder[]
  import_histories        ImportHistory[]
  companies               Company[]
  company_debts           CompanyDebt[]
  company_payments        CompanyPayment[]
  company_daily_snapshots CompanyDailySnapshot[]

  @@map("clients")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  email      String?  @unique
  password   String
  role       UserRole @default(USER)
  first_name String?
  last_name  String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  pin        String?
  client_id  Int

  client                   Client               @relation(fields: [client_id], references: [id])
  created_debtors          Debtor[]             @relation("CreatedBy")
  created_debts            Debt[]               @relation("DebtCreatedBy")
  created_payments         Payment[]            @relation("PaymentCreatedBy")
  created_reminders        PaymentReminder[]    @relation("ReminderCreatedBy")
  created_companies        Company[]            @relation("CompanyCreatedBy")
  created_company_debts    CompanyDebt[]        @relation("CompanyDebtCreatedBy")
  created_company_payments CompanyPayment[]     @relation("CompanyPaymentCreatedBy")
  push_subscriptions       PushSubscription[]
  user_push_preferences    UserPushPreferences?

  @@index([client_id])
  @@map("users")
}

model Debtor {
  id                Int       @id @default(autoincrement())
  external_id       String    @unique @default(uuid())
  first_name        String
  last_name         String
  phone_number      String?
  address           String?
  total_debt        Decimal   @default(0) @db.Decimal(10, 2)
  last_payment_date DateTime?
  is_overdue        Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  created_by        Int
  client_id         Int

  client    Client            @relation(fields: [client_id], references: [id])
  creator   User              @relation("CreatedBy", fields: [created_by], references: [id])
  debts     Debt[]
  payments  Payment[]
  reminders PaymentReminder[]

  @@unique([id, client_id])
  @@index([total_debt])
  @@index([created_by])
  @@index([created_at])
  @@index([is_overdue])
  @@index([last_payment_date])
  @@index([external_id])
  @@index([client_id])
  @@map("debtors")
}

model Debt {
  id          Int      @id @default(autoincrement())
  external_id String   @unique @default(uuid())
  debtor_id   Int
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  items       Json?
  created_at  DateTime @default(now())
  created_by  Int
  client_id   Int

  client  Client @relation(fields: [client_id], references: [id])
  debtor  Debtor @relation(fields: [debtor_id, client_id], references: [id, client_id], onDelete: Cascade, onUpdate: Restrict)
  creator User   @relation("DebtCreatedBy", fields: [created_by], references: [id])

  @@index([debtor_id])
  @@index([created_at])
  @@index([external_id])
  @@index([client_id])
  @@map("debts")
}

model Payment {
  id            Int         @id @default(autoincrement())
  external_id   String      @unique @default(uuid())
  debtor_id     Int
  amount        Decimal     @db.Decimal(10, 2)
  payment_type  PaymentType @default(CASH)
  note          String?
  resets_rating Boolean     @default(false)
  created_at    DateTime    @default(now())
  created_by    Int
  client_id     Int

  client  Client @relation(fields: [client_id], references: [id])
  debtor  Debtor @relation(fields: [debtor_id, client_id], references: [id, client_id], onDelete: Cascade, onUpdate: Restrict)
  creator User   @relation("PaymentCreatedBy", fields: [created_by], references: [id])

  @@index([debtor_id])
  @@index([created_at])
  @@index([external_id])
  @@index([client_id])
  @@map("payments")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PaymentType {
  CASH
  CLICK
  CARD
}

model Settings {
  id         Int      @id @default(autoincrement())
  key        String
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  client_id  Int

  client Client @relation(fields: [client_id], references: [id])

  @@unique([client_id, key])
  @@index([client_id])
  @@map("settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String
  entity_type String
  entity_id   Int?
  old_value   Json?
  new_value   Json?
  description String?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())
  client_id   Int

  client Client @relation(fields: [client_id], references: [id])

  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@index([client_id])
  @@map("audit_logs")
}

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int?
  debtor_id  Int?
  type       NotificationType
  title      String
  message    String
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())
  client_id  Int

  client Client @relation(fields: [client_id], references: [id])

  push_deliveries PushDelivery[]

  @@unique([id, client_id])
  @@index([user_id])
  @@index([debtor_id])
  @@index([is_read])
  @@index([created_at])
  @@index([client_id])
  @@map("notifications")
}

enum NotificationType {
  OVERDUE_PAYMENT
  PAYMENT_RECEIVED
  DEBT_ADDED
  DEBT_LIMIT_EXCEEDED
  HOSTING_REMINDER
  PAYMENT_REMINDER
}

model PaymentReminder {
  id          Int                   @id @default(autoincrement())
  debtor_id   Int
  created_by  Int
  reminder_at DateTime
  note        String?
  status      PaymentReminderStatus @default(PENDING)
  notified_at DateTime?
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt
  client_id   Int

  client  Client @relation(fields: [client_id], references: [id])
  debtor  Debtor @relation(fields: [debtor_id, client_id], references: [id, client_id], onDelete: Cascade, onUpdate: Restrict)
  creator User   @relation("ReminderCreatedBy", fields: [created_by], references: [id])

  @@index([debtor_id])
  @@index([reminder_at])
  @@index([status])
  @@index([created_by])
  @@index([client_id])
  @@map("payment_reminders")
}

enum PaymentReminderStatus {
  PENDING
  NOTIFIED
  COMPLETED
  CANCELLED
}

model ImportHistory {
  id             Int          @id @default(autoincrement())
  user_id        Int
  file_hash      String       @unique
  debtors_count  Int
  debts_count    Int
  payments_count Int
  status         ImportStatus @default(SUCCESS)
  error_message  String?
  created_at     DateTime     @default(now())
  client_id      Int

  client Client @relation(fields: [client_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@index([client_id])
  @@map("import_history")
}

enum ImportStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  user_id    Int
  endpoint   String
  p256dh     String
  auth       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@unique([user_id, endpoint])
  @@index([user_id])
  @@map("push_subscriptions")
}

model UserPushPreferences {
  id                 Int      @id @default(autoincrement())
  user_id            Int      @unique
  enabled            Boolean  @default(false)
  notification_types Json     @default("[]")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_push_preferences")
}

// ============================================================================
// COMPANY (supplier) — shop owes these companies
// ============================================================================

model Company {
  id                Int       @id @default(autoincrement())
  external_id       String    @unique @default(uuid())
  name              String
  contact_person    String?
  phone_number      String?
  address           String?
  total_debt        Decimal   @default(0) @db.Decimal(10, 2)
  last_payment_date DateTime?
  last_debt_date    DateTime?
  is_overdue        Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  created_by        Int
  client_id         Int

  client   Client           @relation(fields: [client_id], references: [id])
  creator  User             @relation("CompanyCreatedBy", fields: [created_by], references: [id])
  debts    CompanyDebt[]
  payments CompanyPayment[]

  @@unique([id, client_id])
  @@index([total_debt])
  @@index([created_by])
  @@index([created_at])
  @@index([is_overdue])
  @@index([last_payment_date])
  @@index([last_debt_date])
  @@index([external_id])
  @@index([name])
  @@index([client_id])
  @@map("companies")
}

model CompanyDebt {
  id          Int      @id @default(autoincrement())
  external_id String   @unique @default(uuid())
  company_id  Int
  amount      Decimal  @db.Decimal(10, 2)
  note        String?
  items       Json?
  created_at  DateTime @default(now())
  created_by  Int
  client_id   Int

  client  Client  @relation(fields: [client_id], references: [id])
  company Company @relation(fields: [company_id, client_id], references: [id, client_id], onDelete: Cascade, onUpdate: Restrict)
  creator User    @relation("CompanyDebtCreatedBy", fields: [created_by], references: [id])

  @@index([company_id])
  @@index([created_at])
  @@index([external_id])
  @@index([client_id])
  @@map("company_debts")
}

model CompanyPayment {
  id           Int         @id @default(autoincrement())
  external_id  String      @unique @default(uuid())
  company_id   Int
  amount       Decimal     @db.Decimal(10, 2)
  payment_type PaymentType @default(CASH)
  note         String?
  receipt_path String?
  receipt_name String?
  receipt_mime String?
  receipt_size Int?
  created_at   DateTime    @default(now())
  created_by   Int
  client_id    Int

  client  Client  @relation(fields: [client_id], references: [id])
  company Company @relation(fields: [company_id, client_id], references: [id, client_id], onDelete: Cascade, onUpdate: Restrict)
  creator User    @relation("CompanyPaymentCreatedBy", fields: [created_by], references: [id])

  @@index([company_id])
  @@index([created_at])
  @@index([external_id])
  @@index([receipt_path])
  @@index([client_id])
  @@map("company_payments")
}

model CompanyDailySnapshot {
  id                     Int      @id @default(autoincrement())
  date                   DateTime @db.Date
  total_outstanding_debt Decimal  @db.Decimal(12, 2)
  debts_sum              Decimal  @default(0) @db.Decimal(12, 2)
  debts_count            Int      @default(0)
  payments_sum           Decimal  @default(0) @db.Decimal(12, 2)
  payments_count         Int      @default(0)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  client_id              Int

  client Client @relation(fields: [client_id], references: [id])

  @@unique([client_id, date])
  @@index([date])
  @@index([client_id])
  @@map("company_daily_snapshots")
}

model SecurityRateLimit {
  key          String   @id
  window_start DateTime @db.Timestamptz
  attempts     Int

  @@map("security_rate_limits")
}

model PushDelivery {
  id              Int       @id @default(autoincrement())
  client_id       Int
  notification_id Int
  subscription_id Int
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  available_at    DateTime  @default(now())
  lease_token     String?   @db.Uuid
  locked_until    DateTime?
  last_error      String?
  created_at      DateTime  @default(now())
  sent_at         DateTime?

  notification Notification     @relation(fields: [notification_id, client_id], references: [id, client_id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, subscription_id])
  @@index([status, available_at, locked_until])
  @@index([client_id])
  @@map("push_deliveries")
}
