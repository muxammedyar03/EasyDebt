generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SHOP - Asosiy izolyatsiya birligi
// ==========================================
model Shop {
  id         Int      @id @default(autoincrement())
  name       String
  is_active  Boolean  @default(true)  // Shop bloklash uchun
  address    String?
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations - Shopga tegishli barcha ma'lumotlar
  users         User[]
  debtors       Debtor[]
  debts         Debt[]
  payments      Payment[]
  notifications Notification[]
  audit_logs    AuditLog[]
  settings      Settings[]

  @@map("shops")
}

model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  email      String?    @unique
  password   String
  role       UserRole   @default(USER)
  status     UserStatus @default(ACTIVE) // Block/Deactivate uchun
  shop_id    Int?       // SUPER_ADMIN uchun null bo'lishi mumkin
  shop       Shop?      @relation(fields: [shop_id], references: [id])
  
  first_name String?
  last_name  String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  // PIN (hashed) - nullable
  pin        String? 

  // Relations
  created_debtors   Debtor[]          @relation("CreatedBy")
  created_debts     Debt[]            @relation("DebtCreatedBy")
  created_payments  Payment[]         @relation("PaymentCreatedBy")
  created_reminders PaymentReminder[] @relation("ReminderCreatedBy")

  @@index([shop_id])
  @@index([status])
  @@map("users")
}

model Debtor {
  id                Int       @id @default(autoincrement())
  shop_id           Int       // Qaysi shopga tegishli
  shop              Shop      @relation(fields: [shop_id], references: [id])
  external_id       String    @unique @default(uuid())
  first_name        String
  last_name         String
  phone_number      String?
  address           String?
  total_debt        Decimal   @default(0) @db.Decimal(10, 2)
  last_payment_date DateTime?
  is_overdue        Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  created_by        Int

  // Relations
  creator   User              @relation("CreatedBy", fields: [created_by], references: [id])
  debts     Debt[]
  payments  Payment[]
  reminders PaymentReminder[]

  // Indexes for performance
  @@index([shop_id])
  @@index([total_debt])
  @@index([created_by])
  @@index([created_at])
  @@index([is_overdue])
  @@index([last_payment_date])
  @@index([external_id])
  @@map("debtors")
}

model Debt {
  id          Int      @id @default(autoincrement())
  shop_id     Int      // Qaysi shopga tegishli
  shop        Shop?     @relation(fields: [shop_id], references: [id])
  external_id String   @unique @default(uuid())
  debtor_id   Int
  debtor      Debtor   @relation(fields: [debtor_id], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  items       Json?    // Store array of items with prices
  created_at  DateTime @default(now())
  created_by  Int

  // Relations
  creator User   @relation("DebtCreatedBy", fields: [created_by], references: [id])

  // Indexes for performance
  @@index([shop_id])
  @@index([debtor_id])
  @@index([created_at])
  @@index([external_id])
  @@map("debts")
}

model Payment {
  id           Int         @id @default(autoincrement())
  shop_id      Int         // Qaysi shopga tegishli
  shop         Shop        @relation(fields: [shop_id], references: [id])
  external_id  String      @unique @default(uuid())
  debtor_id    Int
  debtor       Debtor      @relation(fields: [debtor_id], references: [id], onDelete: Cascade)
  amount       Decimal     @db.Decimal(10, 2)
  payment_type PaymentType @default(CASH)
  note         String?
  created_at   DateTime    @default(now())
  created_by   Int

  // Relations
  creator User   @relation("PaymentCreatedBy", fields: [created_by], references: [id])

  // Indexes for performance
  @@index([shop_id])
  @@index([debtor_id])
  @@index([created_at])
  @@index([external_id])
  @@map("payments")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DEACTIVATED
}

enum PaymentType {
  CASH
  CLICK
  CARD
}

model Settings {
  id         Int      @id @default(autoincrement())
  shop_id    Int?     // null = global settings, not null = shop-specific
  key        String
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  shop Shop? @relation(fields: [shop_id], references: [id])

  @@unique([shop_id, key]) // Har shop uchun key unique
  @@index([shop_id])
  @@map("settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  shop_id     Int?     // null = super admin action, not null = shop-specific
  user_id     Int?
  action      String   // LOGIN, LOGOUT, BLOCK_USER, DEACTIVATE_SHOP, etc.
  entity_type String
  entity_id   Int?
  old_value   Json?
  new_value   Json?
  description String?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  // Relations
  shop Shop? @relation(fields: [shop_id], references: [id])

  @@index([shop_id])
  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Notification {
  id         Int              @id @default(autoincrement())
  shop_id    Int              // Qaysi shopga tegishli
  user_id    Int?
  debtor_id  Int?
  type       NotificationType
  title      String
  message    String
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  // Relations
  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([shop_id])
  @@index([user_id])
  @@index([debtor_id])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}

enum NotificationType {
  OVERDUE_PAYMENT
  PAYMENT_RECEIVED
  DEBT_ADDED
  DEBT_LIMIT_EXCEEDED
  HOSTING_REMINDER
  PAYMENT_REMINDER
}

model PaymentReminder {
  id           Int                   @id @default(autoincrement())
  debtor_id    Int
  created_by   Int
  reminder_at  DateTime
  note         String?
  status       PaymentReminderStatus @default(PENDING)
  notified_at  DateTime?
  created_at   DateTime              @default(now())
  updated_at   DateTime              @updatedAt

  // Relations
  debtor  Debtor @relation(fields: [debtor_id], references: [id], onDelete: Cascade)
  creator User   @relation("ReminderCreatedBy", fields: [created_by], references: [id])

  @@index([debtor_id])
  @@index([reminder_at])
  @@index([status])
  @@index([created_by])
  @@map("payment_reminders")
}

enum PaymentReminderStatus {
  PENDING
  NOTIFIED
  COMPLETED
  CANCELLED
}

model ImportHistory {
  id           Int      @id @default(autoincrement())
  user_id      Int
  file_hash    String   @unique
  debtors_count Int
  debts_count  Int
  payments_count Int
  status       ImportStatus @default(SUCCESS)
  error_message String?
  created_at   DateTime @default(now())

  @@index([user_id])
  @@index([created_at])
  @@map("import_history")
}

enum ImportStatus {
  SUCCESS
  FAILED
  PARTIAL
}
