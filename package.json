    "tailwindcss": "^4.1.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
