{
  "name": "debitor",
  "homepage": "easydebt.uz",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "generate:presets": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/scripts/generate-theme-presets.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "NODE_ENV=production tsx scripts/migrate.ts",
    "docker:build": "DOCKER_BUILDKIT=1 docker compose -f docker-compose.prod.yml build",
    "docker:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:clean": "docker system prune -af --volumes",
    "test:tenant-db": "node --import tsx scripts/tests/tenant-relations.ts",
    "test:permissions-db": "node --import tsx scripts/tests/permissions-tenant.ts",
    "test:audit-cancel-db": "node --import tsx scripts/tests/audit-cancellation-migration.ts",
    "test:tenant-backup": "node --import tsx scripts/tests/tenant-backup.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
