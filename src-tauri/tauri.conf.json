{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyDebt Desktop",
  "version": "2.0.0",
  "identifier": "uz.easydebt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EasyDebt — Qarzlar va To'lovlar Boshqaruv Tizimi",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "../public/avatars/user.png"
    ],
    "category": "Finance",
    "shortDescription": "EasyDebt Offline-First Debt Management System",
    "longDescription": "EasyDebt Desktop — do'kon va korxonalar uchun offlayn ishlovchi hamda bulutli server bilan sinxronlanuvchi qarzlar va to'lovlar boshqaruv dasturi."
  }
}
