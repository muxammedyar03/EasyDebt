{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyDebt Desktop",
  "version": "2.0.0",
  "identifier": "uz.easydebt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EasyDebt — Qarzlar va To'lovlar Boshqaruv Tizimi",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "EasyDebt Offline-First Debt Management System",
    "longDescription": "EasyDebt Desktop — do'kon va korxonalar uchun offlayn ishlovchi hamda bulutli server bilan sinxronlanuvchi qarzlar va to'lovlar boshqaruv dasturi."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyODNFMjM5ODE2M0E1MDkKUldRSnBXT0JPZUtERW9UTHVqZVdKRzFlVXRVYU5rWk5EMFhraTZ5RDJQSmorTjA5Ykdub1FIaEQK",
      "endpoints": [
        "https://github.com/muxammedyar03/EasyDebt/releases/latest/download/latest.json"
      ]
    }
  }
}
