# Authentication
JWT_SECRET="replace-with-strong-jwt-secret"

# Desktop & Sync Configuration
NEXT_PUBLIC_SYNC_SERVER_URL="https://easydebt.uz"
EASYDEBT_LOCAL_DB_PATH=""
USE_MOCK_DATA="false"
NEXT_PUBLIC_USE_MOCK_DATA="false"

# Gemini API (if used)
GEMINI_API_KEY=""
